# LaTeX build artifacts
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv
_minted*/
*.config.minted

# Python cache
__pycache__/
*.py[cod]

# Compiled thesis (figure PDFs in figures/ stay tracked)
/main.pdf
/main-cover.pdf
/main-protected.pdf
/main-spine*.odt
/main-spine*.pdf

# Proprietary fonts a user drops in for engfont/cjkfont belong to them, not to
# this repository — see fonts/README.md. The freely licensed fonts the template
# ships (Tinos, 全字庫 TW-Kai and TW-Sung) are re-included below.
# Every extension engfont/cjkfont can load, not only .ttf: a proprietary face is
# as likely to arrive as an .otf or a .ttc, and dropping one in is what
# fonts/README.md tells the user to do.
/fonts/english/*.ttf
/fonts/english/*.otf
/fonts/english/*.ttc
/fonts/chinese/*.ttf
/fonts/chinese/*.otf
/fonts/chinese/*.ttc
!/fonts/english/Tinos-*.ttf
!/fonts/chinese/TW-Kai-*.ttf
!/fonts/chinese/TW-Sung-*.ttf

# Generated NTU TDR form filler (contains submission/personal data)
/.tdr-upload.js

# Pixi environments and generated fontconfig cache
/.pixi/
