# LaTeX build artifacts
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv
_minted*/
*.config.minted

# Python cache
__pycache__/
*.py[cod]

# Compiled thesis (figure PDFs in figures/ stay tracked)
/main.pdf
/main-cover.pdf
/main-protected.pdf
/main-spine*.odt
/main-spine*.pdf

# Proprietary fonts a user drops in for fontset=template belong to them, not to
# this repository — see fonts/README.md. The freely licensed fonts the template
# ships (Tinos, 全字庫 TW-Kai and TW-Sung) are re-included below.
/fonts/english/*.ttf
/fonts/chinese/*.ttf
!/fonts/english/Tinos-*.ttf
!/fonts/chinese/TW-Kai-*.ttf
!/fonts/chinese/TW-Sung-*.ttf

# Generated NTU TDR form filler (contains submission/personal data)
/.tdr-upload.js

# Pixi environments and generated fontconfig cache
/.pixi/
