# LaTeX build artifacts
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv
_minted*/
*.config.minted

# Python cache
__pycache__/
*.py[cod]

# Compiled thesis (figure PDFs in figures/ stay tracked)
/main.pdf
/main-cover.pdf
/main-protected.pdf
/main-spine*.odt
/main-spine*.pdf

# User-specific font metrics generated by `pixi run line-spacing`
/ntu-line-spacing.tex

# Proprietary fonts a user drops in for \ntufontsetup belong to them, not to this
# repository — see fonts/README.md. The freely licensed fonts the template ships
# (Tinos, 全字庫 TW-Kai and TW-Sung) are re-included below.
# Ignore every other file below fonts/, including files in nested directories.
/fonts/**
!/fonts/README.md
!/fonts/OFL.txt
!/fonts/english/
!/fonts/english/Tinos-Bold.ttf
!/fonts/english/Tinos-BoldItalic.ttf
!/fonts/english/Tinos-Italic.ttf
!/fonts/english/Tinos-Regular.ttf
!/fonts/chinese/
!/fonts/chinese/TW-Kai-98_1.ttf
!/fonts/chinese/TW-Sung-98_1.ttf

# Generated NTU TDR form filler (contains submission/personal data)
/.tdr-upload.js

# Pixi environments and generated fontconfig cache
/.pixi/
